# Connexion utilisée depuis votre machine locale.
DATABASE_URL=postgresql://payload:payload@localhost:5432/payload

# Secret réservé au développement local. Remplacez-le avant tout déploiement.
PAYLOAD_SECRET=change-me-to-a-long-random-secret

# Identifiants PostgreSQL utilisés par Docker Compose.
POSTGRES_DB=payload
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
